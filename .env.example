# AE Cockpit — required API tokens. Copy to .env and fill in.
# NOTE: when this folder lives inside ~/code/quinn, config.py auto-falls back to
# ../quinn-os/.env, so a local .env is only needed for a standalone clone.

# HubSpot private-app token (CRM read: deals, contacts, companies, owners, engagements)
HUBSPOT_API_KEY=

# Gong API (HTTP Basic auth) — calls + transcripts
GONG_ACCESS_KEY=
GONG_SECRET=

# Anthropic (deal intelligence). Without credits the app uses a labeled heuristic fallback.
ANTHROPIC_API_KEY=

# Optional: rep email overrides (owner is otherwise resolved by first name)
# GRANT_EMAIL=
# DEREK_EMAIL=
# ARLEN_EMAIL=
# LUKE_EMAIL=
# IAN_EMAIL=

# Optional runtime
# COCKPIT_REP=grant
# COCKPIT_PORT=8787
